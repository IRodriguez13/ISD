# IR0/Unix login profile — read by ash when started as a login shell.
# The product BusyBox has no id(1) nor hostname(1), so identity comes from the
# environment exported by the console login.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
# Match ncurses fallbacks (linux/vt100/xterm). Avoid bare vt220.
export TERM="${TERM:-linux}"
USER="${USER:-root}"
HOSTNAME="${HOSTNAME:-ir0}"

# Keep prompts compact without relying on bash-only \w expansion.
ir0_prompt_path()
{
	case "$PWD" in
	"$HOME") printf '~' ;;
	"$HOME"/*) printf '~/%s' "${PWD#"$HOME"/}" ;;
	*) printf '%s' "$PWD" ;;
	esac
}

case "$USER" in
root)
	PS1="root@$HOSTNAME"':$(ir0_prompt_path)# '
	;;
*)
	PS1="$USER@$HOSTNAME"':$(ir0_prompt_path)$ '
	;;
esac
export PS1 HOSTNAME USER

alias ll='ls -l'
alias llh='ls -lah'

# Dennis: stage1 mounts virtio-9p tag "dennis" on /heart/dennis/src (as root).
# Login profile keeps a no-op fallback for root shells if stage1 skipped it.
if [ -d /heart/dennis/src ] && [ "$(id -u 2>/dev/null)" = "0" ]; then
	mount -t 9p dennis /heart/dennis/src 2>/dev/null || true
fi
