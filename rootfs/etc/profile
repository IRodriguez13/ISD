# IR0/Unix login profile — read by ash when started as a login shell.
# The product BusyBox has no id(1) nor hostname(1), so identity comes from the
# environment exported by the console login.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export ENV=/etc/ashrc
if [ -n "$DISPLAY" ]; then
	export TERM="${TERM:-xterm}"
else
	export TERM="${TERM:-linux}"
fi
USER="${USER:-root}"
HOSTNAME="${HOSTNAME:-ir0}"

# Use ash PS1 escapes (not functions): inherited PS1 must work in xterm children.
case "$USER" in
root)
	PS1='root@'$HOSTNAME':\w# '
	;;
*)
	PS1="$USER@$HOSTNAME"':\w$ '
	;;
esac
export PS1 HOSTNAME USER

alias ll='ls -l'
alias llh='ls -lah'

# Console login session: product profile plus optional one-shot host override
# (/etc/ir0-session written by make kmang before poweron).
_ir0_session=""
if [ -f /etc/ir0-session ]; then
	_ir0_session="$(tr -d '[:space:]' </etc/ir0-session)"
	rm -f /etc/ir0-session
fi
_ir0_profile="$(cat /etc/ir0-profile 2>/dev/null)"
_auto_x=0
case "$_ir0_session" in
x) _auto_x=1 ;;
terminal) _auto_x=0 ;;
*)
	[ "$_ir0_profile" = "desktop" ] && _auto_x=1
	;;
esac
if [ "$_auto_x" = 1 ] && [ -z "$DISPLAY" ] && [ -x /usr/bin/startx ]; then
	case "$(tty 2>/dev/null)" in
	/dev/console|/dev/tty[0-9]*)
		exec /usr/bin/startx
		;;
	esac
fi

# Dennis Ritchie nod: host IR0 tree via virtio-9p (make run: mount_tag=dennis).
# Offline disk keeps short-name samples under the same path until mounted.
if [ -d /heart/dennis/src ]; then
	mount -t 9p dennis /heart/dennis/src 2>/dev/null || true
fi
