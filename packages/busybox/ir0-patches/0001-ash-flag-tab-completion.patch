+#if ENABLE_SHOW_USAGE && !defined(SINGLE_APPLET_STR)
+/* IR0: expose usage text for ash flag tab-completion (lineedit). */
+const char *FAST_FUNC bb_get_applet_usage(const char *name)
+{
+	const char *p;
+	const char *usage_string;
+	int ap;
+	const char *base;
+
+	if (!name || !name[0])
+		return NULL;
+	base = bb_get_last_path_component_nostrip(name);
+	ap = find_applet_by_name(base);
+	if (ap < 0)
+		return NULL;
+	usage_string = p = unpack_usage_messages();
+	if (!usage_string)
+		return NULL;
+	while (ap) {
+		while (*p++)
+			continue;
+		ap--;
+	}
+	if (*p == '\b') {
+		if (ENABLE_FEATURE_CLEAN_UP && ENABLE_FEATURE_COMPRESS_USAGE)
+			dealloc_usage_messages((char *)usage_string);
+		return NULL;
+	}
+	/* With COMPRESS_USAGE the buffer is heap; leak one unpack for the
+	 * process lifetime so callers can keep the pointer. Uncompressed
+	 * builds point into a static blob — no leak.
+	 */
+	(void)usage_string;
+	return p;
+}
+#else
+const char *FAST_FUNC bb_get_applet_usage(const char *name UNUSED_PARAM)
+{
+	return NULL;
+}
+#endif
