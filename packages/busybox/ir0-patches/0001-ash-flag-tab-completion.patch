+/* IR0: first shell word of the line (command name) for flag completion. */
+static char *dup_cmdline_command(const char *line)
+{
+	const char *s = line;
+	const char *e;
+
+	while (*s == ' ')
+		s++;
+	if (!*s)
+		return NULL;
+	e = s;
+	while (*e && *e != ' ' && *e != '\t'
+	       && *e != '<' && *e != '>' && *e != '|'
+	       && *e != '&' && *e != ';')
+		e++;
+	return xstrndup(s, (size_t)(e - s));
+}
+
+static void try_add_flag(const char *opt, unsigned opt_len, const char *pfx)
+{
+	char *s;
+
+	if (opt_len < 2 || opt[0] != '-')
+		return;
+	s = xstrndup(opt, opt_len);
+	if (is_prefixed_with(s, pfx))
+		add_match(s);
+	else
+		free(s);
+}
+
+/*
+ * Parse BusyBox usage text for -x / --long tokens and optional
+ * /usr/share/ash-completion/<cmd> (one flag per line).
+ */
+static void complete_command_flags(const char *cmd, const char *pfx)
+{
+	const char *usage;
+	const char *s;
+	char path[160];
+	FILE *fp;
+	char line[96];
+
+	if (!cmd || !pfx || pfx[0] != '-')
+		return;
+
+	usage = bb_get_applet_usage(cmd);
+	if (usage) {
+		for (s = usage; *s; s++) {
+			/* full_usage lines: "\n\t-x\t..." or "\n\t--long..." */
+			if (s[0] == '\n' && s[1] == '\t' && s[2] == '-') {
+				const char *o = s + 2;
+				const char *e;
+
+				if (o[1] == '-') {
+					e = o + 2;
+					while (*e && (isalnum(*e) || *e == '-' || *e == '_'))
+						e++;
+				} else {
+					e = o + 1;
+					while (*e && *e != '\t' && *e != '\n' && *e != ' ')
+						e++;
+				}
+				try_add_flag(o, (unsigned)(e - o), pfx);
+				s = e - 1;
+				continue;
+			}
+			/* trivial clusters: [-abcDe...] or [--long] */
+			if (s[0] == '[' && s[1] == '-') {
+				const char *p = s + 2;
+
+				while (*p && *p != ']') {
+					if (p[0] == '-' && p[1] == '-') {
+						const char *e = p + 2;
+
+						while (*e && *e != ']' && *e != '|'
+						       && *e != ' ' && *e != '\t')
+							e++;
+						try_add_flag(p, (unsigned)(e - p), pfx);
+						p = e;
+						continue;
+					}
+					if (*p != ' ' && *p != '|' && *p != '-') {
+						char shortopt[3];
+
+						shortopt[0] = '-';
+						shortopt[1] = *p;
+						shortopt[2] = '\0';
+						try_add_flag(shortopt, 2, pfx);
+					}
+					p++;
+				}
+				s = p;
+				continue;
+			}
+		}
+	}
+
+	/* Non-applet / extra flags (iv, pack, nano, …). */
+	snprintf(path, sizeof(path), "/usr/share/ash-completion/%s",
+		bb_get_last_path_component_nostrip(cmd));
+	fp = fopen(path, "r");
+	if (!fp)
+		return;
+	while (fgets(line, (int)sizeof(line), fp)) {
+		char *nl = strchr(line, '\n');
+		unsigned len;
+
+		if (nl)
+			*nl = '\0';
+		if (!line[0] || line[0] == '#')
+			continue;
+		len = strlen(line);
+		try_add_flag(line, len, pfx);
+	}
+	fclose(fp);
+}
