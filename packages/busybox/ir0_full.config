# IR0 general-purpose BusyBox (never set-user-ID).
#
# Installed as /bin/busybox mode 0755 root:root. Privileged applets (login, su)
# live in a separate reduced binary (ir0_auth.config) so the multi-call
# dispatcher of this large build never sits on the setuid boundary.
#
# Scope: coreutils + the util-linux subset that has a syscall path in IR0.
# Still OFF: networking, init/runit replacements, job control.
# Line editing + tab completion ON for product ash (needs non-canonical TTY).
#
# The Development profile ships every applet here to expose gaps; the applet
# matrix (make busybox-matrix) is what decides supported/partial/unavailable,
# never "it compiled".
#
# Base is upstream `make defconfig` (every applet BusyBox ships) and the lines
# below are the IR0 overlay. Enabling an applet only puts it in the binary; the
# guest matrix still has to prove it runs.
# IR0_BASE=defconfig

CONFIG_BUSYBOX=y
CONFIG_STATIC=y

# Core shell
CONFIG_ASH=y
CONFIG_SH_IS_ASH=y
CONFIG_SH_IS_NONE=n
CONFIG_FEATURE_SH_STANDALONE=y
# Upstream defconfig turns this on, which drops the "BusyBox vX.YZ built-in
# shell (ash)" banner. smoke-runit-ash-interactive keys off that banner to
# decide the shell is interactive and ready for input, so with it quiet the
# smoke never injected its command and timed out after a successful login.
CONFIG_FEATURE_SH_EXTRA_QUIET=n
CONFIG_BASH_IS_NONE=y
CONFIG_ASH_JOB_CONTROL=n
# Line editing + tab completion (product ash). Companion flags match BusyBox
# recommended defaults when FEATURE_EDITING=y — regenerate ir0_full_defconfig
# after changing these (scripts/busybox_regenerate_defconfig.sh).
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_EDITING_MAX_LEN=1024
CONFIG_FEATURE_EDITING_HISTORY=255
CONFIG_FEATURE_EDITING_SAVEHISTORY=y
CONFIG_FEATURE_REVERSE_SEARCH=y
CONFIG_FEATURE_TAB_COMPLETION=y
CONFIG_FEATURE_USERNAME_COMPLETION=y
CONFIG_FEATURE_EDITING_FANCY_PROMPT=y
CONFIG_FEATURE_EDITING_WINCH=y
CONFIG_FEATURE_EDITING_ASK_TERMINAL=n
# Prompt expansion: needed for PS1='user@host:$PWD$ ' in /etc/profile.
CONFIG_ASH_EXPAND_PRMT=y
CONFIG_ASH_TEST=y
CONFIG_ASH_GETOPTS=y
CONFIG_ASH_CMDCMD=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y

# Accounts are read from /etc/passwd, /etc/group and /etc/shadow — no NSS.
CONFIG_USE_BB_PWD_GRP=y
CONFIG_USE_BB_SHADOW=y
# This binary is not setuid: never let an applet assume it can raise privilege.
CONFIG_FEATURE_SUID=n

# Coreutils — file / directory
CONFIG_CAT=y
CONFIG_ECHO=y
# echo -e / -n escape handling; without it `echo -e 'a\tb'` prints the flag.
CONFIG_FEATURE_FANCY_ECHO=y
CONFIG_PWD=y
CONFIG_LS=y
CONFIG_FEATURE_LS_FILETYPES=y
CONFIG_FEATURE_LS_USERNAME=y
# -h sizes shared by ls, df and du; without it `ls -lah` exits 1.
CONFIG_FEATURE_HUMAN_READABLE=y
CONFIG_MKDIR=y
CONFIG_RMDIR=y
CONFIG_RM=y
CONFIG_CP=y
CONFIG_MV=y
CONFIG_TOUCH=y
CONFIG_LN=y
CONFIG_LINK=y
CONFIG_UNLINK=y
CONFIG_READLINK=y
CONFIG_REALPATH=y
CONFIG_STAT=y
CONFIG_CHMOD=y
CONFIG_CHOWN=y
CONFIG_CHGRP=y
CONFIG_MKTEMP=y
CONFIG_MKNOD=y
CONFIG_MKFIFO=y
CONFIG_DD=y
CONFIG_DU=y
CONFIG_DF=y
CONFIG_BASENAME=y
CONFIG_DIRNAME=y

# Coreutils — text / filters
CONFIG_GREP=y
CONFIG_EGREP=y
CONFIG_FGREP=y
CONFIG_HEAD=y
CONFIG_TAIL=y
CONFIG_WC=y
CONFIG_SORT=y
CONFIG_UNIQ=y
CONFIG_CUT=y
CONFIG_TR=y
CONFIG_TEE=y
CONFIG_TAC=y
CONFIG_NL=y
CONFIG_PASTE=y
CONFIG_COMM=y
CONFIG_CMP=y
CONFIG_DIFF=y
CONFIG_FEATURE_DIFF_DIR=y
CONFIG_FEATURE_DIFF_BINARY=y
CONFIG_SPLIT=y
CONFIG_SED=y
CONFIG_AWK=y
CONFIG_XARGS=y
CONFIG_OD=y
CONFIG_HEXDUMP=y
CONFIG_XXD=y
CONFIG_STRINGS=y
CONFIG_FOLD=y
CONFIG_EXPAND=y
CONFIG_UNEXPAND=y
CONFIG_REV=y
CONFIG_MD5SUM=y
CONFIG_SHA1SUM=y
CONFIG_SHA256SUM=y
CONFIG_CKSUM=y
CONFIG_BASE64=y
CONFIG_DOS2UNIX=y
CONFIG_UNIX2DOS=y
CONFIG_PATCH=y

# Coreutils — misc
CONFIG_TEST=y
CONFIG_TRUE=y
CONFIG_FALSE=y
CONFIG_UNAME=y
CONFIG_CLEAR=y
CONFIG_SLEEP=y
CONFIG_USLEEP=y
CONFIG_PRINTF=y
CONFIG_ENV=y
CONFIG_PRINTENV=y
CONFIG_EXPR=y
CONFIG_SEQ=y
CONFIG_YES=y
CONFIG_DATE=y
CONFIG_ID=y
CONFIG_WHOAMI=y
CONFIG_GROUPS=y
CONFIG_LOGNAME=y
CONFIG_NPROC=y
CONFIG_HOSTNAME=y
CONFIG_UPTIME=y
CONFIG_FREE=y
CONFIG_TTY=y

# Inspection
CONFIG_FIND=y
CONFIG_WHICH=y
CONFIG_DMESG=y
CONFIG_LESS=y
CONFIG_MORE=y
CONFIG_MAN=y

# Archives (local only, no network fetch)
CONFIG_TAR=y
CONFIG_GZIP=y
CONFIG_GUNZIP=y

# Processes
CONFIG_PS=y
CONFIG_TOP=y
CONFIG_FEATURE_TOP_INTERACTIVE=y
CONFIG_FEATURE_TOP_CPU_USAGE_PERCENTAGE=y
CONFIG_FEATURE_TOP_CPU_GLOBAL_PERCENTS=y
CONFIG_FEATURE_TOP_SMP_CPU=y
CONFIG_FEATURE_TOP_DECIMALS=y
CONFIG_FEATURE_TOP_SMP_PROCESS=y
CONFIG_KILL=y
CONFIG_KILLALL=y
CONFIG_PIDOF=y
CONFIG_NICE=y
CONFIG_TIME=y

# Terminal
CONFIG_STTY=y
CONFIG_RESET=y

# Mounts (recovery remount path: mount -o remount,rw /)
CONFIG_MOUNT=y
CONFIG_FEATURE_MOUNT_FLAGS=y
CONFIG_UMOUNT=y
CONFIG_MOUNTPOINT=y
CONFIG_CHROOT=y
CONFIG_SWITCH_ROOT=y

# Power / sync (product rootfs + runit)
CONFIG_HALT=y
CONFIG_POWEROFF=y
CONFIG_REBOOT=y
CONFIG_SYNC=y

# Privileged applets live in the reduced auth binary, not here.
CONFIG_LOGIN=n
CONFIG_SU=n
CONFIG_PASSWD=n
CONFIG_SULOGIN=n
CONFIG_GETTY=n
CONFIG_ADDUSER=n
CONFIG_ADDGROUP=n
CONFIG_DELUSER=n
CONFIG_DELGROUP=n

# Networking applets (IR0 has AF_INET + SIOCGIF* + ICMP; see NETWORKING_MATRIX).
CONFIG_IFCONFIG=y
CONFIG_FEATURE_IFCONFIG_STATUS=y
CONFIG_FEATURE_IFCONFIG_HW=y
CONFIG_FEATURE_IFCONFIG_BROADCAST_PLUS=y
CONFIG_PING=y
CONFIG_FEATURE_FANCY_PING=y
CONFIG_ROUTE=y
CONFIG_NETSTAT=y
CONFIG_FEATURE_NETSTAT_WIDE=y
CONFIG_NSLOOKUP=y
CONFIG_NC=y
CONFIG_NC_SERVER=y
CONFIG_NC_EXTRA=y
CONFIG_WGET=y
CONFIG_FEATURE_WGET_STATUSBAR=y
# Keep DHCP client off until userspace DHCP ABI is ready.
CONFIG_UDHCPC=n
CONFIG_TELNETD=n
CONFIG_HTTPD=n
CONFIG_INIT=n
CONFIG_RUNSV=n
CONFIG_SV=n
CONFIG_FEATURE_LESS_MAXLINES=9999999

# Keep off: no init replacement (vi ON for product editors).
CONFIG_VI=y
CONFIG_FEATURE_VI_COLON=y
CONFIG_FEATURE_VI_SEARCH=y
CONFIG_FEATURE_VI_UNDO=y
CONFIG_FEATURE_VI_UNDO_QUEUE=y
CONFIG_FEATURE_VI_UNDO_QUEUE_MAX=256
CONFIG_FEATURE_VI_YANKMARK=y
CONFIG_FEATURE_VI_DOT_CMD=y
CONFIG_FEATURE_VI_SET=y
CONFIG_FEATURE_VI_SETOPTS=y
CONFIG_FEATURE_VI_WIN_RESIZE=y

# Desktop help + util FEATURE_ (product ash / find / tar / ls).
CONFIG_DESKTOP=y
CONFIG_SHOW_USAGE=y
CONFIG_FEATURE_VERBOSE_USAGE=y
CONFIG_LONG_OPTS=y
CONFIG_FEATURE_TAR_CREATE=y
CONFIG_FEATURE_TAR_AUTODETECT=y
CONFIG_FEATURE_TAR_GNU_EXTENSIONS=y
CONFIG_FEATURE_SEAMLESS_GZ=y
CONFIG_FEATURE_FIND_TYPE=y
CONFIG_FEATURE_FIND_MAXDEPTH=y
CONFIG_FEATURE_FIND_EXEC=y
CONFIG_FEATURE_FIND_NOT=y
CONFIG_FEATURE_FIND_PAREN=y
CONFIG_FEATURE_FIND_PRINT0=y
CONFIG_FEATURE_FIND_PERM=y
CONFIG_FEATURE_FIND_SIZE=y
CONFIG_FEATURE_FIND_PATH=y
CONFIG_FEATURE_GREP_CONTEXT=y
CONFIG_FEATURE_LS_TIMESTAMPS=y
CONFIG_FEATURE_STAT_FORMAT=y
CONFIG_FEATURE_XARGS_SUPPORT_ZERO_TERM=y

# Extra applets (no LOADKMAP / UDHCPC / IP / LOGIN — see policy above).
CONFIG_NOHUP=y
CONFIG_TIMEOUT=y
CONFIG_TRUNCATE=y
CONFIG_GETOPT=y
CONFIG_FEATURE_GETOPT_LONG=y
CONFIG_SHUF=y
CONFIG_ZCAT=y

# Privileged applets stay out of this binary (build.sh enforces it): the
# multi-call dispatcher must never sit on the setuid boundary. They ship in
# the reduced ir0_auth.config build instead.
CONFIG_LOGIN=n
CONFIG_SU=n
CONFIG_PASSWD=n
CONFIG_ADDUSER=n
CONFIG_ADDGROUP=n
CONFIG_DELUSER=n
CONFIG_DELGROUP=n
CONFIG_VLOCK=n
CONFIG_SULOGIN=n

# Applets upstream can no longer build against current Linux UAPI headers.
# tc: CBQ classifier (TCA_CBQ_*, struct tc_cbq_lssopt) was removed from the
# kernel uapi, so networking/tc.c does not compile at all.
CONFIG_TC=n
